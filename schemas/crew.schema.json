{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crew.json", "type": "array", "minItems": 1,
  "items": {"type":"object","required":["role","pos","radius","health"],
    "properties": {
      "role": {"enum":["commander","gunner","loader","driver","radio_operator"]},
      "pos": {"type":"object","required":["x","y","z"],"properties":{"x":{"type":"number"},"y":{"type":"number"},"z":{"type":"number"}}},
      "radius": {"type":"number","exclusiveMinimum":0}, "health": {"type":"number","exclusiveMinimum":0},
      "also": {"type":"array","items":{"enum":["commander","gunner","loader","driver","radio_operator"]}},
      "pose": {"enum":["seated","standing"]}}}
}
