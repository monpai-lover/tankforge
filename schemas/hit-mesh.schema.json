{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tankforge:HitMeshManifestV1",
  "title": "Immutable exact emitted render geometry; X1 diagnostic roles remain audit_pending",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "format", "endianness", "generator", "buildRecipeHash", "specId", "buildHash", "manifestHash", "renderGeometryHash", "anatomyDataHash", "sources", "meshes", "assemblies", "meshInstances", "bindings", "surfaces", "audits"],
  "properties": {
    "schema": { "const": "HitMeshManifestV1" },
    "format": { "const": "THMESH1" },
    "endianness": { "const": "LE" },
    "generator": { "type": "object", "additionalProperties": false, "required": ["revision", "sha256"], "properties": { "revision": { "$ref": "#/$defs/key" }, "sha256": { "$ref": "#/$defs/hash" } } },
    "buildRecipeHash": { "$ref": "#/$defs/hash" },
    "specId": { "$ref": "#/$defs/key" },
    "buildHash": { "$ref": "#/$defs/hash" },
    "manifestHash": { "$ref": "#/$defs/hash", "description": "SHA-256 of canonical UTF-8 JSON with this top-level member omitted; independent full-file SHA-256 is required at load." },
    "renderGeometryHash": { "$ref": "#/$defs/hash" },
    "anatomyDataHash": { "$ref": "#/$defs/hash" },
    "sources": { "type": "object", "required": ["assets"], "properties": { "assets": { "type": "array", "maxItems": 1024, "items": { "type": "object", "required": ["kind"], "properties": { "kind": { "$ref": "#/$defs/key" }, "path": { "type": ["string", "null"] }, "status": { "enum": ["available", "missing", "not_declared", "different_source_format"] }, "sha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "decompressedGlbHash": { "$ref": "#/$defs/hash" }, "bytes": { "type": "integer", "minimum": 0 }, "donorSpecId": { "$ref": "#/$defs/key" }, "specId": { "$ref": "#/$defs/key" }, "mounts": { "type": "array", "items": { "type": "string" } } } } }, "normalizedAnatomyHash": { "$ref": "#/$defs/hash" }, "normalizerCoreHash": { "$ref": "#/$defs/hash" } } },
    "meshes": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/mesh" } },
    "assemblies": { "type": "array", "maxItems": 16384, "items": { "type": "object", "additionalProperties": false, "required": ["key", "parent", "baseTransformBits", "pivot", "joint", "allowedMotionFields"], "properties": { "key": { "$ref": "#/$defs/key" }, "parent": { "$ref": "#/$defs/nullableKey" }, "baseTransformBits": { "$ref": "#/$defs/matrixBits" }, "pivot": { "$ref": "#/$defs/point" }, "joint": { "type": "object" }, "allowedMotionFields": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/key" } } } } },
    "meshInstances": { "type": "array", "maxItems": 32768, "items": { "type": "object", "additionalProperties": false, "required": ["key", "meshKey", "assemblyKey", "sourceKey", "worldBits", "instanceBits", "materialFeature", "activityPolicy"], "properties": { "key": { "$ref": "#/$defs/key" }, "meshKey": { "$ref": "#/$defs/key" }, "assemblyKey": { "$ref": "#/$defs/key" }, "sourceKey": { "$ref": "#/$defs/key" }, "worldBits": { "$ref": "#/$defs/matrixBits" }, "instanceBits": { "$ref": "#/$defs/matrixBits" }, "materialFeature": { "type": "object" }, "activityPolicy": { "$ref": "#/$defs/key" } } } },
    "bindings": { "type": "array", "maxItems": 16384, "items": { "type": "object", "required": ["key", "kind", "status"], "properties": { "key": { "$ref": "#/$defs/key" }, "kind": { "enum": ["module", "crew", "armor", "weapon", "track"] }, "status": { "type": "string" }, "moduleId": { "type": "string" }, "moduleKind": { "type": "string" }, "weaponKey": { "$ref": "#/$defs/nullableKey" }, "crewIndex": { "type": "integer", "minimum": 0 }, "crewRole": { "type": "string" } } } },
    "surfaces": { "type": "array", "maxItems": 8192, "items": { "type": "object", "additionalProperties": false, "required": ["key", "role", "topology", "winding", "responseRef", "armorLayerKey", "moduleKey", "crewKey", "fuseEligible", "contactEligible"], "properties": { "key": { "$ref": "#/$defs/key" }, "role": { "enum": ["audit_pending", "armor", "module", "crew", "running_gear", "decoration"] }, "topology": { "enum": ["audit_pending", "boundary_shell", "open_sheet", "closed_solid", "decorative_surface"] }, "winding": { "const": "emitted" }, "responseRef": { "$ref": "#/$defs/nullableKey" }, "armorLayerKey": { "$ref": "#/$defs/nullableKey" }, "moduleKey": { "$ref": "#/$defs/nullableKey" }, "crewKey": { "$ref": "#/$defs/nullableKey" }, "fuseEligible": { "type": ["boolean", "null"] }, "contactEligible": { "type": ["boolean", "null"] } } } },
    "audits": { "type": "object", "required": ["certification", "triangleCoverage", "unclassifiedPhysicalTriangles", "degenerateCount", "boundaryEdges", "nonmanifoldEdges", "topologyPending", "declaredOpenBoundaries", "missingBindings", "ambiguousBindings", "renderPositionDifferences", "shaderDeformation", "activity"], "properties": { "certification": { "const": "audit_pending_diagnostic" }, "triangleCoverage": { "type": "integer", "minimum": 0 }, "unclassifiedPhysicalTriangles": { "type": "integer", "minimum": 0 }, "degenerateCount": { "type": "integer", "minimum": 0 }, "boundaryEdges": { "type": "integer", "minimum": 0 }, "nonmanifoldEdges": { "type": "integer", "minimum": 0 }, "topologyPending": { "type": "boolean" }, "declaredOpenBoundaries": { "type": ["array", "null"] }, "missingBindings": { "type": "integer", "minimum": 0 }, "ambiguousBindings": { "type": "integer", "minimum": 0 }, "renderPositionDifferences": { "const": 0 }, "shaderDeformation": { "type": "string" }, "activity": { "type": "string" } } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "key": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "nullableKey": { "anyOf": [{ "$ref": "#/$defs/key" }, { "type": "null" }] },
    "point": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "matrixBits": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "description": "Raw emitted IEEE-754 float32 words in column-major order, preserving signed zero." },
    "bounds": { "type": "object", "additionalProperties": false, "required": ["lo", "hi"], "properties": { "lo": { "$ref": "#/$defs/point" }, "hi": { "$ref": "#/$defs/point" } } },
    "range": { "type": "object", "additionalProperties": false, "required": ["first", "count", "sourceKey", "surfaceKey", "solidKey", "bindingKey"], "properties": { "first": { "type": "integer", "minimum": 0 }, "count": { "type": "integer", "minimum": 1 }, "sourceKey": { "$ref": "#/$defs/key" }, "surfaceKey": { "$ref": "#/$defs/key" }, "solidKey": { "$ref": "#/$defs/nullableKey" }, "bindingKey": { "$ref": "#/$defs/nullableKey" } } },
    "bvh": { "type": "object", "additionalProperties": false, "required": ["nodes", "order"], "properties": { "nodes": { "type": "array", "maxItems": 2000000, "items": { "type": "object", "additionalProperties": false, "required": ["bounds", "left", "right", "first", "count"], "properties": { "bounds": { "$ref": "#/$defs/bounds" }, "left": { "type": ["integer", "null"], "minimum": 0 }, "right": { "type": ["integer", "null"], "minimum": 0 }, "first": { "type": "integer", "minimum": 0 }, "count": { "type": "integer", "minimum": 0, "maximum": 8 } } } }, "order": { "type": "array", "maxItems": 1000000, "items": { "type": "integer", "minimum": 0 } } } },
    "mesh": { "type": "object", "additionalProperties": false, "required": ["key", "payloadHash", "positionsHash", "renderBufferHash", "vertexCount", "triangleCount", "bounds", "ranges", "bvh"], "properties": { "key": { "$ref": "#/$defs/key" }, "payloadHash": { "$ref": "#/$defs/hash" }, "positionsHash": { "$ref": "#/$defs/hash" }, "renderBufferHash": { "$ref": "#/$defs/hash" }, "vertexCount": { "type": "integer", "minimum": 1, "maximum": 3000000 }, "triangleCount": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "bounds": { "$ref": "#/$defs/bounds" }, "ranges": { "type": "array", "minItems": 1, "maxItems": 1000000, "items": { "$ref": "#/$defs/range" } }, "bvh": { "anyOf": [{ "$ref": "#/$defs/bvh" }, { "type": "null" }] } } }
  }
}
