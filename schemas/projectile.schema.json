{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectileDef",
  "type": "object",
  "required": ["id","name","kind","caliber_mm","mass_kg","muzzle_velocity_ms","explosive_mass_kg","explosive_type","penetrator_material","length_mm","drag_coefficient","penetration_curve","ricochet_angle_deg","fuse_delay_s","fuse_sensitivity_mm"],
  "properties": {
    "id": {"type":"string"}, "name": {"type":"string"},
    "kind": {"enum":["ap","aphe","apcbc","apcr","apds","apfsds","he","heat","heat_fs","hesh","smoke"]},
    "caliber_mm": {"type":"number","exclusiveMinimum":0},
    "mass_kg": {"type":"number","exclusiveMinimum":0},
    "muzzle_velocity_ms": {"type":"number","exclusiveMinimum":0},
    "explosive_mass_kg": {"type":"number","minimum":0},
    "explosive_type": {"type":"string"},
    "penetrator_material": {"type":"string"},
    "length_mm": {"type":"number","exclusiveMinimum":0},
    "drag_coefficient": {"type":"number","minimum":0},
    "penetration_curve": {"type":"array","minItems":1,"items":{"type":"object","required":["distance_m","pen_mm"],"properties":{"distance_m":{"type":"number","minimum":0},"pen_mm":{"type":"number","minimum":0}}}},
    "ricochet_angle_deg": {"type":"number","minimum":0,"maximum":90},
    "normalization_deg": {"type":"number","minimum":0,"maximum":45,"default":0},
    "shatter_angle_deg": {"type":"number","minimum":0,"maximum":90,"default":90},
    "fuse_delay_s": {"type":"number","minimum":0},
    "fuse_sensitivity_mm": {"type":"number","minimum":0}
  }
}
