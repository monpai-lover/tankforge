# TankForge online server behind Caddy/nginx. install.sh fills in @DEST@ and @PORT@.
[Unit]
Description=TankForge online server (lobby and battles)
After=network-online.target
Wants=network-online.target

[Service]
User=tankforge
WorkingDirectory=@DEST@/server
ExecStart=@DEST@/server/tg-server --port @PORT@ --bind 127.0.0.1 --data data --page @DEST@/www/index.html
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
